# The build auto-generates a random password each time it runs, encrypts
# these URLs with it, and XOR-obfuscates the password in the bytecode.
# You only need to provide the plain URLs.
api.memberHud=https://your-api.example.com/users
api.highway=https://your-api.example.com/
api.status=https://your-api.example.com/
api.highwayStatus=https://your-api.example.com/status
